---
import { BRAND_TAGLINE, DATA_ROOT, type NavKey } from "../lib/site";

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <div class="brand-row">
        <span class="brand-mark">Met<span>lake</span></span>
        <span class="brand-pill">history</span>
      </div>
      <p class="brand-tag">{BRAND_TAGLINE}</p>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={current === "overview" ? "page" : undefined}>Overview</a>
      <div
        class="nav-route"
        data-route-picker
        data-current={current === "route" ? "page" : undefined}
      >
        <label class="visually-hidden" for="nav-route-input">Select route</label>
        <input
          id="nav-route-input"
          class="nav-route-input"
          type="search"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="nav-route-list"
          aria-haspopup="listbox"
          data-route-input
          placeholder="Select a route…"
          autocomplete="off"
          spellcheck="false"
        />
        <ul
          id="nav-route-list"
          class="nav-route-list"
          role="listbox"
          data-route-list
          hidden
        ></ul>
      </div>
      <a href="/query/" aria-current={current === "query" ? "page" : undefined}>Query</a>
      <a class="external" href={DATA_ROOT}>/data/</a>
    </nav>
  </div>
</header>

<script>
  import { initRoutePicker } from "../scripts/nav/route-picker";

  const root = document.querySelector<HTMLElement>("[data-route-picker]");
  if (root) void initRoutePicker(root);
</script>

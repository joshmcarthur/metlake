---
import { BRAND_TAGLINE, DATA_ROOT, type NavKey } from "../lib/site";

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="brand-mark">Met<span>lake</span></span>
      <p class="brand-tag">{BRAND_TAGLINE}</p>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={current === "overview" ? "page" : undefined}>Overview</a>
      <div
        class="nav-route"
        data-route-picker
        data-current={current === "route" ? "page" : undefined}
      >
        <button
          type="button"
          class="nav-route-btn"
          data-route-open
          aria-haspopup="dialog"
          aria-controls="route-picker-dialog"
        >
          Select a route
        </button>
        <dialog
          id="route-picker-dialog"
          class="route-dialog"
          data-route-dialog
          aria-labelledby="route-picker-title"
        >
          <div class="route-dialog-panel">
            <div class="route-dialog-head">
              <h2 id="route-picker-title">Select a route</h2>
              <button type="button" class="route-dialog-close" data-route-close aria-label="Close">
                Close
              </button>
            </div>
            <label class="visually-hidden" for="route-picker-search">Search routes</label>
            <input
              id="route-picker-search"
              class="route-dialog-search"
              type="search"
              data-route-search
              placeholder="Search by code or name"
              autocomplete="off"
              spellcheck="false"
            />
            <div class="route-dialog-catalog" data-route-catalog></div>
          </div>
        </dialog>
      </div>
      <a href="/query/" aria-current={current === "query" ? "page" : undefined}>Query</a>
      <a href="/replay/" aria-current={current === "replay" ? "page" : undefined}>Replay</a>
      <a class="external" href={DATA_ROOT}>/data/</a>
    </nav>
  </div>
</header>

<script>
  import { initRoutePicker } from "../scripts/nav/route-picker";

  const root = document.querySelector<HTMLElement>("[data-route-picker]");
  if (root) void initRoutePicker(root);
</script>

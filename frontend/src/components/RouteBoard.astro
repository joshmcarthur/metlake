---
import type { RouteRef } from "../data/placeholder";

interface Props {
  best: RouteRef[];
  attention: RouteRef[];
  interactive?: boolean;
}

const { best, attention, interactive = false } = Astro.props;

function rankLabel(index: number): string {
  return String(index + 1).padStart(2, "0");
}
---

<div class="board">
  <div class="board-col winners">
    <h3>Best punctuality</h3>
    <ol class="rank-list" data-board={interactive ? "best" : undefined}>
      {
        best.map((entry, index) => (
          <li>
            <span class="n">{rankLabel(index)}</span>
            <div>
              <a href={`/routes/${entry.route}/`}>{entry.route}</a>
              <span class="route-name">{entry.name}</span>
            </div>
            <span class="metric">—</span>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="board-col losers">
    <h3>Lowest punctuality</h3>
    <ol class="rank-list" data-board={interactive ? "attention" : undefined}>
      {
        attention.map((entry, index) => (
          <li>
            <span class="n">{rankLabel(index)}</span>
            <div>
              <a href={`/routes/${entry.route}/`}>{entry.route}</a>
              <span class="route-name">{entry.name}</span>
            </div>
            <span class="metric">—</span>
          </li>
        ))
      }
    </ol>
  </div>
</div>

---
interface Props {
  label: string;
  id?: string;
  height?: string;
  bare?: boolean;
}

const { label, id, height, bare = false } = Astro.props;
---

<div
  class:list={["chart-slot", bare && "bare"]}
  id={id}
  style={height ? `--slot-height: ${height}` : undefined}
>
  {!bare && <p>{label}</p>}
</div>

---
import ChartSlot from "../components/ChartSlot.astro";
import HeatmapLegend from "../components/HeatmapLegend.astro";
import PeriodControls from "../components/PeriodControls.astro";
import RouteBoard from "../components/RouteBoard.astro";
import SummaryTiles from "../components/SummaryTiles.astro";
import {
  ATTENTION_ROUTES,
  BEST_ROUTES,
  NETWORK_TILES,
} from "../data/placeholder";
import { DEFAULT_ROUTE } from "../lib/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Metlake — Wellington performance archive"
  current="overview"
  showSiblingNote
  attribution="network"
>
  <main class="wrap">
    <PeriodControls heading="Network performance" headingLevel="h1" showDayChips showCompare />

    <section class="section" aria-labelledby="summary-heading">
      <div class="section-head">
        <h2 id="summary-heading">Summary</h2>
        <p>Metlink published bus performance for the selected period.</p>
      </div>
      <SummaryTiles tiles={NETWORK_TILES} />
    </section>

    <section class="section" aria-labelledby="board-heading">
      <div class="section-head">
        <h2 id="board-heading">Routes</h2>
        <p>Best and softest punctuality · open a route for detail.</p>
      </div>
      <RouteBoard best={BEST_ROUTES} attention={ATTENTION_ROUTES} />
    </section>

    <section class="section viz-grid two">
      <article class="viz-panel" aria-labelledby="cal-heading">
        <div class="viz-head">
          <h2 id="cal-heading">Punctuality by day</h2>
          <p>Which days the network was soft</p>
        </div>
        <ChartSlot id="net-calendar" label="Calendar heat · awaiting data" />
        <HeatmapLegend lowLabel="95%+" highLabel="&lt;84%" />
      </article>

      <article class="viz-panel" aria-labelledby="cancel-heading">
        <div class="viz-head">
          <h2 id="cancel-heading">Cancellations</h2>
          <p>Spike days vs steady noise</p>
        </div>
        <ChartSlot id="net-cancel-spark" label="Cancellation sparkline · awaiting data" />
      </article>
    </section>

    <section class="section viz-panel" aria-labelledby="scatter-heading">
      <div class="viz-head">
        <h2 id="scatter-heading">Peak pain vs all-day score</h2>
        <p>Each point is a route · higher = peak much worse than all-day</p>
      </div>
      <ChartSlot id="net-scatter" label="Route scatter · awaiting data" />
    </section>

    <section class="section viz-panel" aria-labelledby="hour-heading">
      <div class="viz-head">
        <h2 id="hour-heading">When the network loads up</h2>
        <p>Median delay (seconds) by weekday × hour · from trip updates when available</p>
      </div>
      <ChartSlot id="net-hour-heat" label="Hourly heatmap · awaiting data" />
      <HeatmapLegend lowLabel="on time" highLabel="+4m+" />
    </section>

    <section class="section viz-panel" aria-labelledby="corridor-heading">
      <div class="viz-head">
        <h2 id="corridor-heading">Shared choke points</h2>
        <p>Segments that inject delay across multiple routes</p>
      </div>
      <ChartSlot id="net-corridors" label="Corridor table · awaiting data" />
      <div class="actions" style="margin-top: 0.85rem">
        <a class="btn primary-signal" href={`/routes/${DEFAULT_ROUTE}/deep/`}>
          Open route {DEFAULT_ROUTE} deep dive
        </a>
      </div>
    </section>

    <section class="ai-panel" aria-label="Network commentary">
      <p class="ai-status">Commentary will load once the data layer is connected.</p>
    </section>
  </main>
</BaseLayout>

---
import ChartSlot from "../components/ChartSlot.astro";
import CommentaryRail from "../components/CommentaryRail.astro";
import HeatmapLegend from "../components/HeatmapLegend.astro";
import PeriodControls from "../components/PeriodControls.astro";
import RouteBoard from "../components/RouteBoard.astro";
import SummaryTiles from "../components/SummaryTiles.astro";
import {
  ATTENTION_ROUTES,
  BEST_ROUTES,
  NETWORK_TILES,
} from "../data/placeholder";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Metlake — Wellington performance archive"
  current="overview"
  showSiblingNote
  attribution="network"
>
  <div class="wrap page-with-rail" id="overview-root">
    <main class="page-main">
      <div class="archive-empty" id="overview-loading" role="status">
        <p class="eyebrow">Archive</p>
        <h2>Loading performance data</h2>
        <p>Fetching route-performance manifest…</p>
      </div>

      <div class="archive-empty" id="overview-empty" hidden>
        <p class="eyebrow">Archive</p>
        <h2>No performance data yet</h2>
        <p data-empty-detail>
          The archive does not have route-performance parquet for this period.
        </p>
      </div>

      <div id="overview-content" hidden>
        <PeriodControls
          heading="Network performance"
          headingLevel="h1"
          showDayChips
          showCompare
          interactive
        />

        <section class="section" aria-labelledby="summary-heading">
          <div class="section-head">
            <h2 id="summary-heading">Summary</h2>
            <p>Metlink published bus performance for the selected period.</p>
          </div>
          <SummaryTiles tiles={NETWORK_TILES} interactive />
        </section>

        <section class="section" aria-labelledby="board-heading">
          <div class="section-head">
            <h2 id="board-heading">Routes</h2>
            <p>Most and least punctual · open a route for detail.</p>
          </div>
          <RouteBoard best={BEST_ROUTES} attention={ATTENTION_ROUTES} interactive />
        </section>

        <section class="section viz-grid two">
          <article class="viz-panel" aria-labelledby="cal-heading">
            <div class="viz-head">
              <h2 id="cal-heading">Punctuality by day</h2>
              <p>Days when network punctuality dipped</p>
            </div>
            <ChartSlot id="net-calendar" label="Calendar heat" bare />
            <HeatmapLegend lowLabel="95%+" highLabel="&lt;84%" />
          </article>

          <article class="viz-panel" aria-labelledby="cancel-heading">
            <div class="viz-head">
              <h2 id="cancel-heading">Cancellations</h2>
              <p>Share of scheduled trips cancelled each day</p>
            </div>
            <ChartSlot id="net-cancel-spark" label="Cancellation chart" bare />
          </article>
        </section>

        <section class="section viz-panel" aria-labelledby="delay-range-heading">
          <div class="viz-head">
            <h2 id="delay-range-heading">When trips ran late</h2>
            <p>Last-stop arrival, trips at least 1 minute late</p>
          </div>
          <ChartSlot id="net-delay-range" label="Delay range" bare />
        </section>

        <section class="section viz-panel" aria-labelledby="hour-heading">
          <div class="viz-head">
            <h2 id="hour-heading">When the network loads up</h2>
            <p>Median delay (seconds) by weekday × hour · from trip updates when available</p>
          </div>
          <ChartSlot id="net-hour-heat" label="Hourly heatmap" bare />
          <HeatmapLegend lowLabel="on time" highLabel="+4m+" />
        </section>

        <section class="section viz-panel" aria-labelledby="corridor-heading">
          <div class="viz-head">
            <h2 id="corridor-heading">Shared choke points</h2>
            <p>Segments that inject delay across multiple routes</p>
          </div>
          <ChartSlot id="net-corridors" label="Corridor table" bare />
        </section>
      </div>
    </main>

    <CommentaryRail label="Network commentary" />
  </div>

  <script src="../scripts/overview/overview-app.ts"></script>
</BaseLayout>

<style>
  .archive-empty {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    background: var(--paper);
    margin-top: 1.25rem;
  }

  .archive-empty h2 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.125rem;
  }

  .archive-empty p {
    margin: 0;
    color: var(--ink-muted);
  }
</style>

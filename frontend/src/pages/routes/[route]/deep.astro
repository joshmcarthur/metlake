---
import HeatmapLegend from "../../../components/HeatmapLegend.astro";
import PeriodControls from "../../../components/PeriodControls.astro";
import SummaryTiles from "../../../components/SummaryTiles.astro";
import { findRoute, PLACEHOLDER_ROUTES, RECOVERY_TILES } from "../../../data/placeholder";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return PLACEHOLDER_ROUTES.map((entry) => ({
    params: { route: entry.route },
    props: { routeRef: entry },
  }));
}

interface Props {
  routeRef: (typeof PLACEHOLDER_ROUTES)[number];
}

const { route } = Astro.params;
const { routeRef } = Astro.props;
const resolved = routeRef ?? findRoute(route ?? "");
---

<BaseLayout
  title={`Route ${resolved.route} deep dive — Metlake`}
  current="route-deep"
  attribution="deep"
>
  <main class="wrap" id="route-deep-root" data-route={resolved.route} data-route-name={resolved.name}>
    <section class="route-hero">
      <p class="eyebrow">Route deep</p>
      <h1 data-direction-title>{resolved.route} · inbound</h1>
      <p class="desc" data-direction-desc>{resolved.name} · where delay forms</p>
      <div class="direction-toggle" role="group" aria-label="Direction">
        <button type="button" class="chip" data-direction="inbound" aria-pressed="true">Inbound</button>
        <button type="button" class="chip" data-direction="outbound" aria-pressed="false">
          Outbound
        </button>
      </div>
    </section>

    <PeriodControls heading="Period" showCompare={false} interactive />

    <section class="section">
      <ul class="callout-insights">
        <li>
          <strong>Reading the profile</strong>
          Median delay grows along the trip. Flat segments = holding schedule; steep rises =
          delay injected between those stops.
        </li>
        <li>
          <strong>Awaiting trip updates</strong>
          Stop-level delay profiles will render here once GTFS-RT-derived tables are available.
        </li>
      </ul>
    </section>

    <section class="section viz-panel" aria-labelledby="profile-heading">
      <div class="viz-head">
        <h2 id="profile-heading">Delay along the route</h2>
        <p>Median delay at each stop · band = 25th–75th percentile (seconds late)</p>
      </div>
      <div id="profile-root" class="chart-slot-disabled" aria-label="Stop profile chart"></div>
    </section>

    <section class="section viz-grid two">
      <article class="viz-panel" aria-labelledby="inject-heading">
        <div class="viz-head">
          <h2 id="inject-heading">Where delay is introduced</h2>
          <p>Average extra seconds added between consecutive stops</p>
        </div>
        <ol class="injector-list" id="injector-list" aria-label="Delay injector list"></ol>
      </article>

      <article class="viz-panel" aria-labelledby="tod-heading">
        <div class="viz-head">
          <h2 id="tod-heading">Delay through the day</h2>
          <p>Median trip delay (seconds) by weekday × departure hour</p>
        </div>
        <div class="heatmap" id="heatmap-root" aria-label="Time-of-day heatmap"></div>
        <HeatmapLegend lowLabel="on time" highLabel="+4m+" />
      </article>
    </section>

    <section class="section viz-panel" aria-labelledby="recovery-heading">
      <div class="viz-head">
        <h2 id="recovery-heading">Recovery vs fade</h2>
        <p>
          Share of trips that were &gt;2.5 min late mid-route, then finished within grace
        </p>
      </div>
      <SummaryTiles tiles={RECOVERY_TILES} bare />
    </section>

    <section class="section" aria-labelledby="export-heading">
      <div class="section-head">
        <h2 id="export-heading">Export</h2>
        <p>Download this view, or browse the files under <code>/data/</code>.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/query/">Open in query</a>
        <button type="button" class="btn secondary" disabled>Download stop profile CSV</button>
        <a class="btn secondary" href={`/routes/${resolved.route}/`}>Back to scorecard</a>
      </div>
    </section>

    <section class="ai-panel" aria-label="Route commentary">
      <p class="ai-status">Commentary will load once the data layer is connected.</p>
    </section>
  </main>

  <script src="../../../scripts/route-deep/route-deep-app.ts"></script>
</BaseLayout>

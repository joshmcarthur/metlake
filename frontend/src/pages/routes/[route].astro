---
import CommentaryRail from "../../components/CommentaryRail.astro";
import HeatmapLegend from "../../components/HeatmapLegend.astro";
import PeriodControls from "../../components/PeriodControls.astro";
import SummaryTiles from "../../components/SummaryTiles.astro";
import {
  findRoute,
  PLACEHOLDER_ROUTES,
  RECOVERY_TILES,
  ROUTE_SHELL,
  ROUTE_TILES,
} from "../../data/placeholder";
import { queryPageHref } from "../../lib/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [
    ...PLACEHOLDER_ROUTES.map((entry) => ({
      params: { route: entry.route },
      props: { routeRef: entry },
    })),
    { params: { route: ROUTE_SHELL.route }, props: { routeRef: ROUTE_SHELL } },
  ];
}

interface Props {
  routeRef: (typeof PLACEHOLDER_ROUTES)[number];
}

const { route } = Astro.params;
const { routeRef } = Astro.props;
const resolved = routeRef ?? findRoute(route ?? "");
---

<BaseLayout
  title={
    resolved.name
      ? `Route ${resolved.route} · ${resolved.name} — Metlake`
      : `Route ${resolved.route} — Metlake`
  }
  current="route"
  attribution="route"
>
  <div
    class="wrap page-with-rail"
    id="route-root"
    data-route={resolved.route}
    data-route-name={resolved.name}
  >
    <main class="page-main">
      <div class="archive-empty" id="route-loading" role="status">
        <p class="eyebrow">Route</p>
        <h2>Loading route performance</h2>
        <p>Fetching route-performance manifest…</p>
      </div>

      <div class="archive-empty" id="route-empty" hidden>
        <p class="eyebrow">Route</p>
        <h2>No performance data yet</h2>
        <p data-empty-detail>
          The archive does not have route-performance parquet for this route or period.
        </p>
      </div>

      <div id="route-content" hidden>
        <section class="route-hero">
          <p class="eyebrow">Route</p>
          <h1>{resolved.route}</h1>
          <p class="desc">{resolved.name}</p>
        </section>

        <PeriodControls heading="Period" interactive showCompare />

        <section class="section">
          <SummaryTiles tiles={ROUTE_TILES} interactive variant="route" />
        </section>

        <section class="section viz-panel" aria-labelledby="series-heading">
          <div class="viz-head">
            <div>
              <h2 id="series-heading">Daily published rates</h2>
              <p>Percent of scheduled trips · one point per day</p>
            </div>
            <div class="metric-toggle" role="group" aria-label="Published rates">
              <button type="button" class="chip" data-metric-chip="punctuality" aria-pressed="true">
                Punctuality
              </button>
              <button type="button" class="chip" data-metric-chip="reliability" aria-pressed="true">
                Reliability
              </button>
              <button type="button" class="chip" data-metric-chip="peak" aria-pressed="false">
                Peak punctuality
              </button>
            </div>
          </div>
          <div id="route-series"></div>
        </section>

        <section class="section viz-panel" aria-labelledby="delay-range-heading">
          <div class="viz-head">
            <h2 id="delay-range-heading">When trips ran late</h2>
            <p>Last-stop arrival, trips at least 1 minute late</p>
          </div>
          <div class="chart-slot bare" id="route-delay-range"></div>
        </section>

        <section class="section viz-panel" aria-labelledby="profile-heading">
          <div class="viz-head">
            <div>
              <h2 id="profile-heading">Delay along the route</h2>
              <p>Median delay at each stop (seconds late)</p>
            </div>
            <div class="direction-toggle" role="group" aria-label="Direction">
              <button type="button" class="chip" data-direction="inbound" aria-pressed="true">
                Inbound
              </button>
              <button type="button" class="chip" data-direction="outbound" aria-pressed="false">
                Outbound
              </button>
            </div>
          </div>
          <div id="profile-root" class="chart-slot-disabled" aria-label="Stop profile chart"></div>
        </section>

        <section class="section viz-grid two delay-anatomy-grid">
          <article class="viz-panel" aria-labelledby="inject-heading">
            <div class="viz-head">
              <div>
                <h2 id="inject-heading">Where delay is introduced</h2>
                <p>Average extra seconds added between consecutive stops</p>
              </div>
            </div>
            <ol class="injector-list" id="injector-list" aria-label="Delay injector list"></ol>
          </article>

          <article class="viz-panel" aria-labelledby="tod-heading">
            <div class="viz-head">
              <div>
                <h2 id="tod-heading">Delay through the day</h2>
                <p>Median trip delay (seconds) by weekday × departure hour</p>
              </div>
            </div>
            <div class="heatmap" id="heatmap-root" aria-label="Time-of-day heatmap"></div>
            <HeatmapLegend lowLabel="on time" highLabel="+4m+" />
          </article>
        </section>

        <section class="section viz-panel" aria-labelledby="recovery-heading">
          <div class="viz-head">
            <h2 id="recovery-heading">Recovery vs fade</h2>
            <p>
              Share of trips that were &gt;2.5 min late mid-route, then finished within grace
            </p>
          </div>
          <SummaryTiles tiles={RECOVERY_TILES} bare />
        </section>

        <section class="section" aria-labelledby="export-heading">
          <div class="section-head">
            <h2 id="export-heading">Export</h2>
            <p>CSV of this slice, or the underlying Parquet month file.</p>
          </div>
          <div class="actions">
            <a class="btn" data-query-link href={queryPageHref(resolved.route)}>Open in query</a>
            <button type="button" class="btn secondary" data-export-csv disabled>Download CSV</button>
            <a class="btn secondary" data-parquet-link href="/data/">Parquet</a>
          </div>
        </section>
      </div>
    </main>

    <CommentaryRail label="Route commentary" />
  </div>

  <script src="../../scripts/route/route-app.ts"></script>
</BaseLayout>

<style>
  .archive-empty {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    background: var(--paper);
    margin-top: 1.25rem;
  }

  .archive-empty h2 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.125rem;
  }

  .archive-empty p {
    margin: 0;
    color: var(--ink-muted);
  }
</style>

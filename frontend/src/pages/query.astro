---
import { DATA_ROOT } from "../lib/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Query — Metlake" current="query" attribution="route">
  <main class="wrap" id="query-root">
    <section class="route-hero">
      <p class="eyebrow">Data access</p>
      <h1>Query</h1>
      <p class="desc">
        Ask a question in SQL, download the result, or grab the underlying files from
        <code>{DATA_ROOT}</code>.
      </p>
    </section>

    <div class="query-layout">
      <section class="query-panel" aria-labelledby="sql-heading">
        <h2 id="sql-heading">SQL</h2>
        <label class="visually-hidden" for="sql">DuckDB SQL</label>
        <textarea class="sql" id="sql" spellcheck="false"></textarea>
        <div class="actions">
          <button type="button" class="btn primary-signal" data-run-sql disabled>Run query</button>
          <button type="button" class="btn secondary" data-download-csv disabled>Download CSV</button>
          <button type="button" class="btn secondary" data-reset-sql disabled>Reset sample</button>
        </div>
        <p class="note query-status" id="query-status" style="margin-top: 1rem">
          Loading archive manifest…
        </p>
      </section>

      <section class="result-panel" aria-labelledby="result-heading">
        <h2 id="result-heading">Result</h2>
        <div class="table-scroll">
          <table class="data" id="result-table">
            <thead></thead>
            <tbody>
              <tr>
                <td>Run a query to see results.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="files-heading">Files</h2>
        <p class="files-intro" data-files-note>
          Same paths you'll find under <code>{DATA_ROOT}</code>:
        </p>
        <ul class="file-links" data-file-links></ul>
      </section>
    </div>
  </main>

  <script src="../scripts/query/query-app.ts"></script>
</BaseLayout>

<style>
  .query-status.error {
    color: var(--warn);
  }
</style>

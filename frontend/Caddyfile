:80 {
	handle_path /data/* {
		root * /data
		file_server browse
	}

	# Sibling handles are mutually exclusive. Nested handles inside the SPA
	# catch-all do not work: Caddy runs try_files before nested handle, so
	# unknown /routes/{id}/ paths were rewritten to /index.html (overview).
	@routeScorecard path_regexp ^/routes/[^/]+/?$
	handle @routeScorecard {
		root * /srv
		try_files {path} {path}/ {path}/index.html /routes/__any__/index.html
		file_server
	}

	handle {
		root * /srv
		try_files {path} {path}/ {path}/index.html /index.html
		file_server
	}
}
